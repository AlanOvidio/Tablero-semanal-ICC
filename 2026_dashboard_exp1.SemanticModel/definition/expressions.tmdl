expression fxLecturasEstacion_met_diario =
		(estacionId as number, RangeStart as datetime, RangeEnd as datetime) =>
		let
		    fechaini = DateTime.ToText(RangeStart, "yyyy-MM-dd HH:mm"),
		    fechafin = DateTime.ToText(RangeEnd, "yyyy-MM-dd HH:mm"),
		
		    Origen = Json.Document(
		        Web.Contents(
		            "https://redmet.icc.org.gt/ws/getlecturasdia",
		            [
		                Query = [
		                    fechaini   = fechaini,
		                    fechafin   = fechafin,
		                    estacionid = Number.ToText(estacionId)
		                ],
		                Timeout = #duration(0, 0, 5, 0)
		            ]
		        )
		    ),
		
		    Lecturas = try Origen[data] otherwise {}
		in
		    Lecturas
	lineageTag: c6ca2b25-c957-454e-b6dd-0febc5cb1692

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

