				        each if [velocidad_viento] <> null and [direccion_viento] <> null
				             then [velocidad_viento] * Number.Cos([direccion_viento] * Number.PI / 180)
				             else null,
				        type number
				    ),
				
				    // Agrupar por estacion + fecha + hora
