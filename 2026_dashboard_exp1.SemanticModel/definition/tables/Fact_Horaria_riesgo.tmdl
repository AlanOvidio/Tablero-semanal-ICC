				        AgregarRoya, "Flag_Salivosa",
				        each if [Temp_Media] <> null and [HR_Media] <> null and [Precip_Total] <> null
				             and [Temp_Media] >= 22 and [Temp_Media] <= 28
				             and [HR_Media] > 80
