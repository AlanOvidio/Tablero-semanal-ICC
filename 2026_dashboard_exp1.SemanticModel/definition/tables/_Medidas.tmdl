			    AVERAGE(Fact_Horaria_riesgo[Viento_Media]),
			    Fact_Horaria_riesgo[Hora] >= HoraDesde,
			    Fact_Horaria_riesgo[Hora] <= HoraHasta,
			    Fact_Horaria_riesgo[Viento_Media] >= U,
			    NOT ISBLANK(Fact_Horaria_riesgo[Sector_Viento])
			)
		formatString: 0.0
