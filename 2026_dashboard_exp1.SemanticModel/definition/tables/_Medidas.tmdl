	measure Hora_Fin_Luz = AVERAGE(Fact_Subdiaria_met_aux[Hora_Fin_Luz])
		formatString: 0.00
		displayFolder: Radiación
		lineageTag: 547b4948-e8ab-4253-aed5-c275c8268f51

	column Column
		formatString: 0
		lineageTag: 4a43f51a-7fde-4903-b7b3-e87f991a9814
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Medidas = calculated
		mode: import
		source = Row("Column", BLANK())

