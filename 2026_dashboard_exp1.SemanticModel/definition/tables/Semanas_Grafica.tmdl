	partition Semanas_Grafica = m
		mode: import
		source =
				let
				    Fuente = Calendario,
				    Seleccion = Table.SelectColumns(
				        Fuente,
				        {
				            "Semana_Etiqueta",
				            "Semana_Hidrologica",
				            "Año_Hidrologico",
				            "Inicio_Semana"
				        }
				    ),
				    SinDuplicados = Table.Distinct(Seleccion),
				    Ordenado = Table.Sort(
				        SinDuplicados,
				        {{"Inicio_Semana", Order.Ascending}}
				    )
				in
				    Ordenado

	annotation PBI_NavigationStepName = Navegación

