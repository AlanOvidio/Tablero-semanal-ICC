table _Riesgos
	lineageTag: 827a2a36-dfb9-5afa-810f-8d598536bc26

	/// Roya café (Caña de azúcar). Unidad: días/semana. Las esporas requieren una película de agua ≥ 6 h para germinar; temperatura óptima de germinación 21 °C. Día favorable: Tmed 15–25 °C, HR media > 80 % y ≥ 6 h de mojadura. Hora favorable: T 15–25 °C, HR > 80 %, mojadura > 4.
	measure R_CAN_ROYA_CAFE =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR mojt = CALCULATE(MAX(Fact_Subdiaria_met_aux[Mojadura_Horas_Total]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(hr) && NOT ISBLANK(mojt) && ( tmed >= 15 && tmed <= 25 && hr > 80 && mojt >= 6 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 6b6576b4-7926-5b5e-bcaf-c22a5cc0ab7a

	/// Roya naranja (Caña de azúcar). Unidad: días/semana. Día favorable: Tmed 20–25 °C (cualquier mojadura) o Tmed > 25 °C con mojadura > 8 h. Desfavorable: Tmed < 20 °C, o > 25 °C con mojadura < 8 h. Germinación óptima con HR > 98 % y 21 °C. Esporula hasta la madurez y aun en época seca.
	measure R_CAN_ROYA_NARANJA =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR mojt = CALCULATE(MAX(Fact_Subdiaria_met_aux[Mojadura_Horas_Total]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(mojt) && ( ( tmed >= 20 && tmed <= 25 ) || ( tmed > 25 && mojt > 8 ) ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: ee052c5e-5e44-5fc9-8c85-58eda9ba238c

	/// Escaldadura foliar (Caña de azúcar). Unidad: días/semana. Importante en Guatemala: la alternancia de periodos lluviosos severos y secos severos favorece su expresión; se dispersa con la combinación de lluvia y viento fuertes. Día de dispersión: lluvia > 20 mm y viento máx > 30 km/h.
	measure R_CAN_ESCALDADURA =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			            VAR vmax = CALCULATE(MAX(Fact_Subdiaria_met_aux[Viento_Max]))
			            RETURN IF(NOT ISBLANK(p) && NOT ISBLANK(vmax) && ( p > 20 && vmax > 30 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: bac5ecfd-c950-5315-bea0-3ae4b8eebb76

	/// Salivosa (Aeneolamia) (Caña de azúcar). Unidad: días/semana. Aparece en abril con las primeras lluvias: 50–100 mm de lluvia inicial acumulan humedad suficiente para la eclosión de la mayoría de los huevos. La población se relaciona con la lluvia de 4 semanas antes; presenta 3–4 picos en la época lluviosa y desaparece en noviembre por el fotoperiodo, aunque siga lloviendo. Día favorable: lluvia > 5
	measure R_CAN_SALIVOSA =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        FILTER(VALUES(Calendario[Fecha]), MONTH(Calendario[Fecha]) IN { 4, 5, 6, 7, 8, 9, 10, 11 }),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(hr) && NOT ISBLANK(p) && ( p > 5 && hr > 80 && tmed >= 22 && tmed <= 30 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 5f0087b3-943e-5582-bdba-17d2a5f615cd

	/// Barrenador (Diatraea) (Caña de azúcar). Unidad: días/semana. La infestación aumenta con el establecimiento de la época seca y en la maduración. Día favorable: Tmed > 24 °C, HR media 60–80 %, día seco. 4–5 generaciones/año en El Salvador (oct–jun). Hora favorable (aproximación para el mapa de calor): T > 24 °C, HR 60–80 % y sin lluvia.
	measure R_CAN_BARRENADOR =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(hr) && NOT ISBLANK(p) && ( tmed > 24 && hr >= 60 && hr <= 80 && p < 1 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: dc919c91-a6c5-557d-8c98-fa8c855b8a3a

	/// Chinche de encaje (Caña de azúcar). Unidad: días secos/semana. Plaga en aumento en la zona cañera. Las lluvias intensas de julio a septiembre la reducen (derriban las colonias de ninfas); el estrés por exceso de humedad o por sequía la favorece. Semana favorable: sin días con lluvia > 20 mm y ≥ 4 días secos.
	measure R_CAN_CHINCHE_ENCAJE =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    CALCULATE(
			        VAR _fuerte = CALCULATE(COUNTROWS(FILTER(Fact_Diaria_met, Fact_Diaria_met[Precip_Total] > 20)))
			        VAR _secos = CALCULATE(COUNTROWS(FILTER(Fact_Diaria_met, Fact_Diaria_met[Precip_Total] < 1)))
			        RETURN IF(COALESCE(_fuerte, 0) > 0, 0, COALESCE(_secos, 0))
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 90655dc1-eacd-54d2-879f-f48fcf4f671c

	/// Coludo (saltahojas antillano) (Caña de azúcar). Unidad: días/semana. Plaga exótica favorecida por la época seca (noviembre–abril, incluida la transición): baja precipitación, alta evapotranspiración y baja humedad relativa. Día favorable: día seco y HR media < 70 %.
	measure R_CAN_COLUDO =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        FILTER(VALUES(Calendario[Fecha]), MONTH(Calendario[Fecha]) IN { 11, 12, 1, 2, 3, 4 }),
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			            RETURN IF(NOT ISBLANK(hr) && NOT ISBLANK(p) && ( p < 1 && hr < 70 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: f4e16f9e-c68a-5ad4-a4d4-86811915827d

	/// Estrés térmico (Caña de azúcar). Unidad: horas/semana. Hora con T > 36 °C (umbral máximo de estrés para caña de azúcar; rango óptimo 20–33 °C) y radiación > 800 W/m².
	measure R_CAN_ESTRES =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Horaria_riesgo))
			    )
			RETURN
			AVERAGEX(_Est, COALESCE(CALCULATE(COUNTROWS(FILTER(Fact_Horaria_riesgo, Fact_Horaria_riesgo[Temp_Media] > 36 && Fact_Horaria_riesgo[Rad_Media] > 800))), 0))
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 78b50888-ba38-5ead-b896-1c3ce2d661d1

	/// Suelo saturado: limitación de cosecha y tránsito (Caña de azúcar). Unidad: días/semana. Día con lluvia > 10 mm durante la zafra: anegamiento del suelo que limita el corte, el alce y el tránsito de maquinaria.
	measure R_CAN_SUELO_SATURADO =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        FILTER(VALUES(Calendario[Fecha]), MONTH(Calendario[Fecha]) IN { 11, 12, 1, 2, 3, 4, 5 }),
			            VAR p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			            RETURN IF(NOT ISBLANK(p) && ( p > 10 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 3446b936-3360-5e7d-bdad-820c655ab5d0

	/// Ventana para aplicación aérea (Caña de azúcar). Unidad: horas aptas/día. Hora apta para aplicar (madurantes y otros productos): T < 30 °C, HR > 60 % y viento < 10 km/h, de día. Evitar la inversión térmica (diciembre–febrero, noches despejadas y sin viento). Indicador positivo: horas aptas por día.
	measure R_CAN_APLICACION =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Horaria_riesgo))
			    )
			RETURN
			AVERAGEX(_Est, DIVIDE(COALESCE(CALCULATE(COUNTROWS(FILTER(Fact_Horaria_riesgo, Fact_Horaria_riesgo[Temp_Media] < 30 && Fact_Horaria_riesgo[HR_Media] > 60 && Fact_Horaria_riesgo[Viento_Media] < 10 && Fact_Horaria_riesgo[Rad_Media] > 40))), 0), CALCULATE(DISTINCTCOUNT(Fact_Horaria_riesgo[Fecha]))))
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: e2cbd146-7194-58f2-8f11-80c1e59684e0

	/// Riesgo de quema / incendio (Caña de azúcar). Unidad: días/semana. Día con HR mínima < 40 %, viento máximo > 20 km/h y ≥ 3 días secos consecutivos.
	measure R_CAN_QUEMA =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR _d = Calendario[Fecha]
			            VAR hrmin = CALCULATE(MIN(Fact_Diaria_met[HR_Min]))
			            VAR vmax = CALCULATE(MAX(Fact_Subdiaria_met_aux[Viento_Max]))
			            VAR seco3 = CALCULATE(COUNTROWS(FILTER(Fact_Diaria_met, Fact_Diaria_met[Precip_Total] < 1)), DATESBETWEEN(Calendario[Fecha], _d - 2, _d))
			            RETURN IF(NOT ISBLANK(hrmin) && NOT ISBLANK(vmax) && ( hrmin < 40 && vmax > 20 && seco3 = 3 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 08066ec8-9ddf-5e12-af8b-6782b5ec52a7

	/// Condiciones de maduración (Caña de azúcar). Unidad: días/semana. Condiciones favorables a la acumulación de sacarosa, de 4 a 6 semanas antes del corte: oscilación térmica día-noche ≈ 15 °C, lluvia de 30–100 mm/mes y 11.5–12.5 h de luz. El exceso de humedad en suelo y planta (inicio de zafra) la frena. Día favorable: amplitud térmica ≥ 15 °C; mes favorable: lluvia 30–100 mm. Semáforo invertido.
	measure R_CAN_MADURACION =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        FILTER(VALUES(Calendario[Fecha]), MONTH(Calendario[Fecha]) IN { 11, 12, 1, 2, 3, 4 }),
			            VAR _d = Calendario[Fecha]
			            VAR tmin = CALCULATE(MIN(Fact_Diaria_met[Temp_Min]))
			            VAR tmax = CALCULATE(MAX(Fact_Diaria_met[Temp_Max]))
			            VAR p30 = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]), DATESBETWEEN(Calendario[Fecha], _d - 29, _d))
			            RETURN IF(NOT ISBLANK(tmin) && NOT ISBLANK(tmax) && ( (tmax - tmin) >= 15 && p30 >= 30 && p30 <= 100 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 560991e9-a75d-5c2a-b941-2d33b9f235c3

	/// Sigatoka negra (Banano). Unidad: días/semana. Óptimo 26–28 °C; la infección cae bajo ~20 °C (requiere ~21.5–28 °C). HR > 80 % favorable y > 90 % fuertemente asociada; lluvia frecuente y mojadura persistente. Radiación alta la reduce. Día favorable: Tmed 21.5–28 °C, HR media > 90 % y > 4 h de mojadura nocturna. Índice acumulado: días favorables en 14 días.
	measure R_BAN_SIG_NEGRA =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR mojn = CALCULATE(MAX(Fact_Subdiaria_met_aux[Mojadura_Horas_Nocturna]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(hr) && NOT ISBLANK(mojn) && ( tmed >= 21.5 && tmed <= 28 && hr > 90 && mojn > 4 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 0a52466a-89a5-5c99-8c67-3377080cd306

	/// Moko (dispersión) (Banano). Unidad: semana. Semana con lluvia > 100 mm y balance positivo (dispersión por agua).
	measure R_BAN_MOKO =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    CALCULATE(
			        VAR _p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			        VAR _b = CALCULATE(SUM(Fact_Diaria_met[Balance_Hidrico]))
			        RETURN IF(_p > 100 && _b > 0, 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 44d2c7ba-6cc3-57ea-a4f7-51771f7aa43a

	/// Volcamiento por viento (Banano). Unidad: km/h. Viento máximo diurno > 40 km/h (precaución) / > 60 km/h (alerta).
	measure R_BAN_VOLCAMIENTO = CALCULATE(MAX(Fact_Subdiaria_met_aux[Viento_Max_Diurno]))
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: a98cf20f-8fb9-5969-bdcb-3f3a369e9f28

	/// Estrés térmico (Banano). Unidad: horas/semana. Hora con T > 38 °C (umbral máximo de estrés para banano; rango óptimo 20–30 °C) y radiación > 800 W/m².
	measure R_BAN_ESTRES =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Horaria_riesgo))
			    )
			RETURN
			AVERAGEX(_Est, COALESCE(CALCULATE(COUNTROWS(FILTER(Fact_Horaria_riesgo, Fact_Horaria_riesgo[Temp_Media] > 38 && Fact_Horaria_riesgo[Rad_Media] > 800))), 0))
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 845b7047-5cb7-50e4-890c-4b262f00a882

	/// Phytophthora (pudrición de raíz) (Aguacate). Unidad: días/semana. Humedad alta, temperaturas altas y exceso de agua (mal drenaje). Día favorable: Tmed 20–30 °C y balance diario > 0.
	measure R_AGU_PHYTO =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR bal = CALCULATE(SUM(Fact_Diaria_met[Balance_Hidrico]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(bal) && ( tmed >= 20 && tmed <= 30 && bal > 0 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: ae4d04b3-9bc7-5b40-a2e4-e3af26a78c72

	/// Antracnosis (Aguacate). Unidad: días/semana. Favorecida por temperaturas altas y humedad; la lluvia la dispersa. Día favorable: Tmed 20–30 °C, HR media > 80 % y lluvia > 1 mm o > 6 h de mojadura.
	measure R_AGU_ANTRACNOSIS =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			            VAR mojt = CALCULATE(MAX(Fact_Subdiaria_met_aux[Mojadura_Horas_Total]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(hr) && NOT ISBLANK(p) && NOT ISBLANK(mojt) && ( tmed >= 20 && tmed <= 30 && hr > 80 && ( p > 1 || mojt > 6 ) ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 0d6c9c24-da5c-5e9f-b9e7-a852107e61ba

	/// Frío (Aguacate). Unidad: días/semana. Tmín < 12 °C (umbral mínimo de estrés para aguacate).
	measure R_AGU_FRIO =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmin = CALCULATE(MIN(Fact_Diaria_met[Temp_Min]))
			            RETURN IF(NOT ISBLANK(tmin) && ( tmin < 12 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 9da51a24-da80-52b6-89e5-ae3309458979

	/// Golpe de calor / quemadura de fruto (Aguacate). Unidad: horas/semana. Hora con T > 36 °C (umbral máximo de estrés para aguacate; rango óptimo 15–30 °C) y radiación > 800 W/m².
	measure R_AGU_CALOR =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Horaria_riesgo))
			    )
			RETURN
			AVERAGEX(_Est, COALESCE(CALCULATE(COUNTROWS(FILTER(Fact_Horaria_riesgo, Fact_Horaria_riesgo[Temp_Media] > 36 && Fact_Horaria_riesgo[Rad_Media] > 800))), 0))
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 4ca6e457-7aba-52fe-af09-5b37cf80da1b

	/// Caída de flor y fruto por viento (Aguacate). Unidad: km/h. Vientos fuertes causan caída de flor y fruto. Viento máximo diurno > 30 / 45 km/h.
	measure R_AGU_VIENTO = CALCULATE(MAX(Fact_Subdiaria_met_aux[Viento_Max_Diurno]))
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 6fc854f2-abd6-5041-ba2f-efda0975c892

	/// Pudrición del cogollo (P. palmivora) (Palma de aceite). Unidad: días/semana. Severidad mayor con HR alta, lluvias frecuentes y encharcamiento; los periodos secos la reducen; el patógeno tolera 11–35 °C. Día favorable: lluvia > 5 mm y HR media > 90 %. Índice: días favorables en 14 días. Hora favorable (aproximación para el mapa de calor): T 11–35 °C, HR > 90 % y lluvia > 0.
	measure R_PAL_PC =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR p = CALCULATE(SUM(Fact_Diaria_met[Precip_Total]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(hr) && NOT ISBLANK(p) && ( tmed >= 11 && tmed <= 35 && hr > 90 && p > 5 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: f9b9de48-3bd9-58db-aa6f-f45cf839f57f

	/// Estrés térmico (Palma de aceite). Unidad: horas/semana. Hora con T > 34 °C (umbral máximo de estrés para palma de aceite; rango óptimo 22–32 °C) y radiación > 800 W/m².
	measure R_PAL_ESTRES =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Horaria_riesgo))
			    )
			RETURN
			AVERAGEX(_Est, COALESCE(CALCULATE(COUNTROWS(FILTER(Fact_Horaria_riesgo, Fact_Horaria_riesgo[Temp_Media] > 34 && Fact_Horaria_riesgo[Rad_Media] > 800))), 0))
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: 7496fe99-5c9d-5010-9b48-1ddb1cfa4c21

	/// Maíz – Mancha de asfalto (Granos básicos). Unidad: días/semana. Favorecida por temperaturas frescas (16–22 °C) y HR alta: HR media > 75 % y 7 h de mojadura nocturna. Aparece unas 2 semanas antes de la floración y alcanza su máximo ~6 semanas después. Presente en el altiplano de Guatemala.
	measure R_MAI_ASFALTO =
			VAR _Est =
			    FILTER(
			        VALUES(Estaciones_met[estacionid]),
			        NOT ISEMPTY(CALCULATETABLE(Fact_Diaria_met))
			    )
			RETURN
			AVERAGEX(
			    _Est,
			    SUMX(
			        VALUES(Calendario[Fecha]),
			            VAR tmed = CALCULATE(AVERAGE(Fact_Diaria_met[Temp_Media]))
			            VAR hr = CALCULATE(AVERAGE(Fact_Diaria_met[HR_Media]))
			            VAR mojn = CALCULATE(MAX(Fact_Subdiaria_met_aux[Mojadura_Horas_Nocturna]))
			            RETURN IF(NOT ISBLANK(tmed) && NOT ISBLANK(hr) && NOT ISBLANK(mojn) && ( tmed >= 16 && tmed <= 22 && hr > 75 && mojn >= 7 ), 1, 0)
			    )
			)
		formatString: 0.#
		displayFolder: Riesgos por ID
		lineageTag: a8ac6cfa-932c-5229-a900-fefaedb12d93

