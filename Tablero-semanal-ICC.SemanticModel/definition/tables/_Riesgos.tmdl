	/// Indica si la estación tiene algún valor de riesgo calculado (para distinguir «sin datos» en el mapa).
	measure Riesgo_Valor_Max_Estacion = MAXX(VALUES(Riesgos_Cultivo[ID]), [Riesgo_Valor])
		formatString: 0.#
		displayFolder: Contexto
		lineageTag: ade9284a-f914-5a0e-8bb3-47afa0b1942a

	/// Filtro de la leyenda del mapa de riesgos: número de alertas, o semáforo si hay un riesgo elegido.
	measure Leyenda_Riesgo_Mostrar =
			VAR _uno = ISFILTERED(Riesgos_Cultivo[Riesgo]) && HASONEVALUE(Riesgos_Cultivo[ID])
			RETURN IF(SELECTEDVALUE(Leyenda_Mapa_Riesgo[Modo]) = IF(_uno, "Riesgo", "Conteo"), 1)
		formatString: 0
		displayFolder: Contexto
		lineageTag: 60bd9297-a0d3-5234-a119-fc49b424650a

	/// Color de la fila de la leyenda del mapa de riesgos.
	measure Leyenda_Riesgo_Color = SELECTEDVALUE(Leyenda_Mapa_Riesgo[Color])
		displayFolder: Contexto
		lineageTag: 7f7582e5-4f65-5575-88c8-7e65f083e1af

	/// Color del texto de la leyenda del mapa de riesgos.
	measure Leyenda_Riesgo_Fuente = IF([Leyenda_Riesgo_Color] IN {"#2171B5", "#08306B", "#D64550", "#3BA272"}, "#FFFFFF", "#252525")
		displayFolder: Contexto
		lineageTag: 3a8534e8-f973-5cc1-a60f-8587e9a17fdc

	/// Título del mapa de riesgos y de su leyenda.
	measure Leyenda_Riesgo_Titulo =
			VAR _uno = ISFILTERED(Riesgos_Cultivo[Riesgo]) && HASONEVALUE(Riesgos_Cultivo[ID])
			RETURN IF(_uno, "Semáforo de " & LOWER(SELECTEDVALUE(Riesgos_Cultivo[Riesgo])), "Riesgos en alerta por estación")
		displayFolder: Contexto
		lineageTag: e21617aa-9a20-5ad6-81c3-32389ee0cc43

