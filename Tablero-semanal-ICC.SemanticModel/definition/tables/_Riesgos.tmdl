	/// Color del mapa de la página de estrés: DPV máximo diurno con la paleta del mapa de calor.
	measure Mapa_DPV_Color =
			VAR _x = [VPD_Max_Diurna]
			RETURN IF(ISBLANK(_x), "#BDBDBD", SWITCH(TRUE(), _x < 0.4, "#6BAED6", _x < 1.2, "#A1D99B", _x < 1.6, "#FED976", "#F03B20"))
		displayFolder: Contexto
		lineageTag: 1919a154-08f8-5454-8070-7b2a4c279fad

	/// Color del mapa de riesgos: número de riesgos en alerta (azules: 0, 1, 2–3, ≥ 4; blanco sin datos); con un riesgo elegido en el semáforo, su color de semáforo.
	measure Mapa_Riesgo_Color =
			VAR _uno = ISFILTERED(Riesgos_Cultivo[Riesgo]) && HASONEVALUE(Riesgos_Cultivo[ID])
			VAR _n = [Riesgos_En_Alerta]
			RETURN
			IF(_uno, [Riesgo_Color], SWITCH(TRUE(), ISBLANK([Riesgo_Valor_Max_Estacion]), "#FFFFFF", COALESCE(_n, 0) = 0, "#C6DBEF", _n = 1, "#6BAED6", _n <= 3, "#2171B5", "#08306B"))
		displayFolder: Contexto
		lineageTag: d9f758d8-6536-5cc8-a956-c8fe170f93b4

	/// Acumulado del año actual desde el inicio de la ventana (4, 8, 12 semanas o inicio del año) hasta la semana del eje (MJ/m²). Eje: Semanas_Grafica.
