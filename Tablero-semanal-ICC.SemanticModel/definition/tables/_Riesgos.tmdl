	/// Color del texto de la leyenda.
	measure Leyenda_Fuente = IF([Leyenda_Color] IN { "#54278F", "#A63603", "#A50F15", "#252525", "#969696", "#9E9AC8", "#FB6A4A", "#4575B4", "#D73027", "#2171B5", "#F03B20", "#E31A1C", "#3182BD", "#4292C6", "#08519C", "#41AB5D", "#006D2C", "#D95F0E", "#C0392B" }, "#FFFFFF", "#252525")
		displayFolder: Mapa de calor
